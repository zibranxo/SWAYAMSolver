# SWAYAM Solver - Local Environment Configuration
# Copy this file to .env and configure your credentials

# LLM Provider: groq | openai | openrouter | deepseek | ollama | custom
SWAYAM_PROVIDER=groq

# API Base URL
SWAYAM_BASE_URL=https://api.groq.com/openai/v1

# API Key (Required for remote providers like Groq, OpenAI, OpenRouter, DeepSeek)
SWAYAM_API_KEY=

# Model Name
SWAYAM_MODEL=llama-3.3-70b-versatile

# Temperature (0.0 to 1.0)
SWAYAM_TEMPERATURE=0.1

# Anti-Detection & Safety Defaults
SWAYAM_HUMAN_PACING=true
SWAYAM_STEALTH_MODE=false
SWAYAM_AUTO_SCROLL=true
SWAYAM_BYPASS_RESTRICTIONS=true

# Automation Defaults
SWAYAM_AUTO_SELECT=true
SWAYAM_HIGHLIGHT_ONLY=false
SWAYAM_SHOW_REASONING=true
SWAYAM_AUTO_SUBMIT=false
SWAYAM_AUTO_SUBMIT_DELAY=5000
